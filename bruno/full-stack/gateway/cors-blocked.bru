meta {
  name: CORS blocks an unknown origin
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/auth/health
  body: none
  auth: none
}

headers {
  Origin: http://evil.com
}

tests {
  test("does not echo an unlisted origin", function() {
    expect(res.getHeader("access-control-allow-origin")).to.not.equal("http://evil.com");
  });
}

