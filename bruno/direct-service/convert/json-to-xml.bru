meta {
  name: JSON to XML
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/convert/json-to-xml
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "input": "{\"name\":\"John\",\"age\":30}"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("converts correctly", function() {
    expect(res.body.output).to.include("<name>John</name>");
  });
}

