meta {
  name: CSV to JSON
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/convert/csv-to-json
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "input": "name,age\nJohn,30"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("converts correctly", function() {
    expect(res.body.output).to.include("John");
  });
}

