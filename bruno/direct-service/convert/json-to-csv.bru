meta {
  name: JSON to CSV
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/convert/json-to-csv
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "input": "[{\"name\":\"John\",\"age\":\"30\"}]"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("converts correctly", function() {
    expect(res.body.output).to.include("age,name");
  });
}

