meta {
  name: JSON to YAML
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/convert/json-to-yaml
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "input": "{\"name\":\"John\"}"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("converts correctly", function() {
    expect(res.body.output).to.include("name: John");
  });
}

