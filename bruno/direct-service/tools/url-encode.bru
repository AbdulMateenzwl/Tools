meta {
  name: URL Encode
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/tools/url/encode
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "input": "https://convertx.io?a=1&b=2"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("returns expected output", function() {
    expect(res.body.output).to.include("%3A");
  });
}

