# =============================================================
# ConvertX — environment template
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored — never commit real values
# =============================================================

# LocalStack Pro auth token (https://app.localstack.cloud → Auth Token)
# Required: the Pro image will not start without a valid token.
LOCALSTACK_AUTH_TOKEN=

# Master password for the RDS PostgreSQL instance
POSTGRES_PASSWORD=

# OPTIONAL. LocalStack's ElastiCache has no AUTH, so the bootstrap does not
# store a Redis password at all. Only meaningful against real AWS, where the
# cluster would be created with --auth-token.
REDIS_PASSWORD=
