# Local development for the conversion service.
#
#   cp .env.example .env
#
# Read by BOTH docker-compose.yml (for ${...} substitution) and by the service
# itself at startup, so `go run ./cmd/main.go` needs no inline variables.
#
# Delete or rename .env to go back to the zero-dependency in-memory cache.
# Real environment variables always win over this file, so it has no effect in
# a deployed container.

# ── read by the app ─────────────────────────────────────────────────────────
# Setting REDIS_HOST selects the plain-Redis backend.
REDIS_HOST=localhost:6379

# ── read by BOTH ────────────────────────────────────────────────────────────
# The app authenticates with it; compose passes it to redis --requirepass.
REDIS_PASSWORD=localdev

# ── read by docker-compose.yml ──────────────────────────────────────────────
REDIS_PORT=6379
# 4566 is usually already taken by another LocalStack.
LOCALSTACK_PORT=4567

# ── uncomment for the SecretsManager path instead ───────────────────────────
# Takes precedence over REDIS_HOST. Needs: docker compose --profile aws up -d
# AWS_ENDPOINT_URL=http://localhost:4567
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
